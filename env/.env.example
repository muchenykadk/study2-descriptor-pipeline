# Copy this file to .env and fill in your keys. Never commit .env to git.

# --- Vision API provider ---
# Options: "anthropic" | "gemini" | "ollama"
VISION_PROVIDER=anthropic

# Model string per provider:
#   anthropic → claude-sonnet-4-6 / claude-opus-4-8
#   gemini    → gemini-2.5-pro
#   ollama    → llava:latest / pixtral / qwen-vl (must be running locally)
VISION_MODEL=claude-sonnet-4-6

# --- API keys (only the one matching VISION_PROVIDER is needed) ---
ANTHROPIC_API_KEY=your_key_here
# GOOGLE_API_KEY=your_key_here
# OLLAMA_BASE_URL=http://localhost:11434   # default if omitted
